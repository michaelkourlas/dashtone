<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:title="@string/settings_category_library"
        android:summary="@string/settings_category_library_summary">

        <Preference
            android:key="pref_permission"
            android:title="@string/settings_permission_title"
            android:persistent="false" />

        <Preference
            android:key="pref_rescan"
            android:title="@string/rescan_library_action"
            android:persistent="false" />

        <PreferenceScreen
            android:key="pref_screen_included_folders"
            android:title="@string/settings_included_folders_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_category_browse_categories"
        android:title="@string/settings_category_browse_categories"
        android:summary="@string/settings_browse_categories_summary" />

    <PreferenceCategory
        android:title="@string/settings_category_shuffle"
        android:summary="@string/settings_category_shuffle_summary">

        <ListPreference
            android:key="pref_category_shuffle_mode"
            android:title="@string/settings_category_shuffle_mode_title"
            android:summary="%s"
            android:entries="@array/category_shuffle_mode_entries"
            android:entryValues="@array/category_shuffle_mode_values"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preferences_about_category_name">

        <Preference
            android:key="pref_about_app"
            android:title="@string/app_name"
            android:summary="@string/copyright">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="@string/github_url" />
        </Preference>

        <Preference
            android:key="pref_about_changelog"
            android:title="@string/preferences_about_changelog_title"
            android:persistent="false">
            <intent
                android:targetClass="net.kourlas.dashtone.MarkdownActivity"
                android:targetPackage="net.kourlas.dashtone">
                <extra
                    android:name="document"
                    android:value="CHANGELOG" />
            </intent>
        </Preference>

        <Preference
            android:title="@string/preferences_about_license_title"
            android:summary="@string/preferences_about_license_summary"
            android:persistent="false">
            <intent
                android:targetClass="net.kourlas.dashtone.MarkdownActivity"
                android:targetPackage="net.kourlas.dashtone">
                <extra
                    android:name="document"
                    android:value="LICENSE" />
            </intent>
        </Preference>

        <Preference
            android:title="@string/preferences_about_privacy_title"
            android:persistent="false">
            <intent
                android:targetClass="net.kourlas.dashtone.MarkdownActivity"
                android:targetPackage="net.kourlas.dashtone">
                <extra
                    android:name="document"
                    android:value="PRIVACY" />
            </intent>
        </Preference>

        <Preference
            android:title="@string/preferences_about_third_party_embedded_title"
            android:persistent="false">
            <intent
                android:targetClass="net.kourlas.dashtone.MarkdownActivity"
                android:targetPackage="net.kourlas.dashtone">
                <extra
                    android:name="document"
                    android:value="NOTICE" />
            </intent>
        </Preference>

        <Preference
            android:title="@string/preferences_about_third_party_packages_title"
            android:persistent="false">
            <intent
                android:targetClass="net.kourlas.dashtone.MarkdownActivity"
                android:targetPackage="net.kourlas.dashtone">
                <extra
                    android:name="document"
                    android:value="PACKAGE_LICENSES" />
            </intent>
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
